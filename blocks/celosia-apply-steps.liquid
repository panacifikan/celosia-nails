<div class="celosia-apply-steps" {{ block.shopify_attributes }}>
  {% for i in (1..5) %}
    {% assign step_key = 'step_' | append: i %}
    {% assign step_text = block.settings[step_key] %}
    {% if step_text != blank %}
      <div class="celosia-apply-steps__row">
        <span class="celosia-apply-steps__num">{{ i }}</span>
        <p class="celosia-apply-steps__text">{{ step_text }}</p>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .celosia-apply-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 12px 0;
  }
  @media screen and (min-width: 750px) {
    .celosia-apply-steps {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }
  .celosia-apply-steps__row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #FFFFFF;
    border-radius: 14px;
    padding: 12px;
  }
  .celosia-apply-steps__num {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #F2D2D7;
    color: #241519;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .celosia-apply-steps__text {
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Celosia: Apply steps",
  "settings": [
    { "type": "textarea", "id": "step_1", "label": "Step 1" },
    { "type": "textarea", "id": "step_2", "label": "Step 2" },
    { "type": "textarea", "id": "step_3", "label": "Step 3" },
    { "type": "textarea", "id": "step_4", "label": "Step 4" },
    { "type": "textarea", "id": "step_5", "label": "Step 5" }
  ]
}
{% endschema %}
